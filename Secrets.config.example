<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to Secrets.config and fill in your own values.
  Secrets.config is ignored by git, so your password never gets committed.
  For Gmail, use an App Password (Google Account > Security > App passwords).
-->
<appSettings>
  <add key="SmtpEmail" value="you@gmail.com" />
  <add key="SmtpPassword" value="your-gmail-app-password" />
</appSettings>
